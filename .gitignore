# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python cache / local env
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Logs / temporary files
*.log
*.tmp
*.bak
*.swp

# Large raw and processed datasets
Data/raw/
Data/DRP_Training_Data/*.hdf
Data/DRP_Training_Data/*.h5
Data/DRP_Training_Data/*.hdf5
Data/DRP_Training_Data/*.csv
!Data/DRP_Training_Data/*_summary.json

# Official DRKG dump and regenerated DRKG subgraph outputs
DRKG_pipeline/official_data/
DRKG_pipeline/cache/
DRKG_pipeline/outputs/

# Model checkpoints and fold-level heavy outputs
*.pt
*.pth
*.ckpt
results/*_full_folds/
results/**/all_test_predictions.csv

# Reproduction output folders generated by reruns
results/reproduced_*/
DRKG_pipeline/outputs/reproduced_*/

# Optional binary artifacts; keep final small DRKG feature files only if explicitly added
*.rds
*.pkl
*.pickle

# Local archives
*.zip
*.7z
*.tar
*.tar.gz
